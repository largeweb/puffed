{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puffed",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".vercel/output/static",
  "vars": { "ENVIRONMENT": "DEVELOPMENT" },
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "puffed",
      "database_id": "fef01190-390e-4be9-af4c-aa3275960b60"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "puff"
    }
  ],

  "env": {
    "preview": {
      "vars": { "ENVIRONMENT": "PREVIEW" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "puffed",
          "database_id": "fef01190-390e-4be9-af4c-aa3275960b60"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "puff"
        }
      ]
    },
    "production": {
      "vars": { "ENVIRONMENT": "PRODUCTION" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "puffed",
          "database_id": "fef01190-390e-4be9-af4c-aa3275960b60"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "puff"
        }
      ]
    }
  },

  "observability": {
    "enabled": true
  }
}
